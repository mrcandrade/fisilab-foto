<?xml version="1.0" encoding="utf-8"?>
<!--
  Foto MSI (Suíte FisiLab — FisiLab, LARFIC/UFRGS; based on the PhotoCraft MSI). The suite ships
  an Inno Setup installer built by its orchestrator; this WiX file is kept, rebranded, for reference
  and for the icon checks in apps/photocraft/src/app_icon.rs.

  Upstream description: PhotoCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build photocraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc photocraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Suite FisiLab\Foto by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Abrir o Foto" box. Installs a Start Menu shortcut, makes
  Foto the owner of `.pcraft`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus fisilab-foto-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Foto"
      Manufacturer="FisiLab — LARFIC/UFRGS"
      Version="$(var.Version)"
      UpgradeCode="D1471B2A-A70F-4585-83BD-47F1129F01BA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Foto — Editor de imagens (Suíte FisiLab)" Manufacturer="FisiLab — LARFIC/UFRGS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais nova do Foto já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="FotoIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FotoIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mrcandrade/larfic/tree/main/suite-fisilab" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mrcandrade/fisilab-foto/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mrcandrade/fisilab-foto/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="FisiLabFolder" Name="Suite FisiLab">
        <Directory Id="INSTALLFOLDER" Name="Foto" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by the FotoApp component). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\FisiLab\Foto" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Foto" Level="1">
      <ComponentGroupRef Id="FotoFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFoto"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photocraft.en-us.wxl. -->
    <Property Id="FotoVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="O Foto $(var.DisplayVersion) está instalado. Você pode abri-lo a qualquer momento pelo menu Iniciar." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Abrir o Foto" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#FotoExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchFoto" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="FotoFiles" Directory="INSTALLFOLDER">
      <Component Id="FotoApp" Guid="4B1511B4-4786-491E-A07A-063C0FAC1744">
        <File Id="FotoExe" Source="$(var.BinDir)\fisilab-foto.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Foto"
              Description="Foto — Editor de imagens (Suíte FisiLab)" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FotoIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: the native format (inherited from PhotoCraft); Foto is its default app. -->
        <ProgId Id="FisiLab.Foto.Document" Description="Documento do Foto" Icon="FotoExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-photocraft">
            <Verb Id="open" Command="Abrir" TargetFile="FotoExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="FisiLab.Foto.PhotoshopDocument" Description="Documento PSD" Icon="FotoExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.Foto.PhotoshopDocument\shell\open\command" Value="&quot;[#FotoExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="FisiLab.Foto.Image" Description="Imagem" Icon="FotoExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FisiLab.Foto.Image\shell\open\command" Value="&quot;[#FotoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="FisiLab.Foto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="FisiLab.Foto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.kra\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.krz\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="FisiLab.Foto.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "fisilab-foto"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe" Name="FriendlyAppName" Value="Foto" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\shell\open\command" Value="&quot;[#FotoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\fisilab-foto.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fisilab-foto.exe" Value="[#FotoExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FisiLab\Foto" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="FotoCli">
        <File Id="FotoCliExe" Source="$(var.BinDir)\fisilab-foto-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
