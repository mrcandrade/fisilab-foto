<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.foto</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Foto</name>
  <summary>Editor de imagens — Suíte FisiLab (alternativa livre)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O Foto é um editor de imagens nativo e livre, da Suíte FisiLab, com os menus, atalhos,
      painéis e ferramentas que se espera de um editor profissional: camadas, máscaras,
      camadas de ajuste, estilos de camada, texto e pincéis.
    </p>
    <ul>
      <li>Abre, edita e salva arquivos PSD e PSB em camadas</li>
      <li>Documentos de 8, 16 e 32 bits em RGB, tons de cinza, CMYK e Lab</li>
      <li>Compositor na GPU com filtros em várias threads</li>
    </ul>
    <p>
      Baseado no PhotoCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.foto.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.foto</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-foto/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>fisilab-foto</binary>
    <mediatype>application/x-photocraft</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>application/x-krita</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psb</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
